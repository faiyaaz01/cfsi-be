# MongoDB Database Settings
# For Local MongoDB:
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=cfsi_db

# For MongoDB Atlas (Cloud), uncomment and paste your Atlas connection string:
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# JWT Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=<paste-generated-secret-here>
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Create the first administrator only when no admin account exists.
BOOTSTRAP_ADMIN_USERNAME=admin@cfsi.com
BOOTSTRAP_ADMIN_PASSWORD=Password@1

# Server Config
HOST=0.0.0.0
PORT=8000
